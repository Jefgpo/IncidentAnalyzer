# Copiá este archivo a .env y completá los valores. NUNCA subas .env al repositorio.

# Clave del proveedor de IA (opcional; hoy Anthropic/Claude: https://console.anthropic.com/).
# Sin ella la IA queda deshabilitada y la app funciona completa.
AI_API_KEY=
# Modelo usado para redacción y chat
AI_MODEL=claude-opus-5-5
# Filas de evidencia por hallazgo enviadas a la IA (muestra representativa)
AI_MAX_EVIDENCE_ROWS=12

# Reputación de IPs con AbuseIPDB (opcional). Cada usuario usa SU propia clave; también se puede pegar en la pantalla
# "Analizar → Reputación de IPs" solo para la sesión. Gratis en https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# Máximo de IPs públicas consultadas por defecto y caché de resultados (segundos)
INTEL_MAX_IPS=25
INTEL_CACHE_TTL_S=86400

# Límites y seguridad
MAX_UPLOAD_MB=25
MAX_ROWS=500000
# Sesiones: "disk" = cifradas en disco, sobreviven a recargas y reinicios; "memory" = nada toca el disco
SESSION_STORE=disk
# Horas sin uso antes de borrar la sesión automáticamente (se renueva con cada acción)
SESSION_TTL_HOURS=24
# Clave Fernet para cifrar las sesiones. Si se deja vacía se genera una junto a los datos;
# para datos reales generá una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
